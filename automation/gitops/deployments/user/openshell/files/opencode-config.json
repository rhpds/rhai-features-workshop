{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/__LLM_MODEL__",
  "enabled_providers": ["litellm"],
  "plugin": ["@mlflow/opencode"],
  "provider": {
    "litellm": {
      "api": "openai",
      "name": "LiteLLM",
      "env": ["OPENAI_API_KEY"],
      "options": {
        "baseURL": "__LLM_BASE_URL__"
      },
      "models": {
        "__LLM_MODEL__": {
          "name": "__LLM_MODEL__",
          "tool_call": true,
          "reasoning": true,
          "attachment": false,
          "temperature": true,
          "limit": { "context": 131072, "output": 16384 },
          "cost": { "input": 0, "output": 0 }
        }
      }
    }
  }
}
